<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <!-- Each UI test drives its own independent, isolated browser session, so
         these are safe to run concurrently. -->
    <test name="UI Tests" parallel="methods" thread-count="3">
        <classes>
            <class name="com.automation.ui.LoginTest"/>
            <class name="com.automation.ui.DashboardTest"/>
            <class name="com.automation.ui.FundTransferTest"/>
            <class name="com.automation.ui.BeneficiaryTest"/>
            <class name="com.automation.ui.BillPaymentTest"/>
            <class name="com.automation.ui.FixedDepositTest"/>
            <class name="com.automation.ui.LoanCalculatorTest"/>
            <class name="com.automation.ui.TransactionHistoryTest"/>
        </classes>
    </test>

    <!-- Kept sequential: every class here shares one demo account's balance on
         a Vercel-hosted mock backend, whose state isn't reliably consistent
         across concurrent requests (observed stale reads under parallel load,
         consistent with per-instance in-memory state rather than a real
         shared datastore). Running this block in parallel with itself or
         alongside the UI block produces flaky balance/history assertions. -->
    <test name="API Tests">
        <classes>
            <class name="com.automation.api.AuthApiTest"/>
            <class name="com.automation.api.AccountsApiTest"/>
            <class name="com.automation.api.TransferApiTest"/>
            <class name="com.automation.api.TransactionHistoryApiTest"/>
        </classes>
    </test>

</suite>